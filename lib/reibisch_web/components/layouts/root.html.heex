<!DOCTYPE html>
<html lang={assigns[:lang] || "de"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reibisch — Tomke Reibisch · Software &amp; Beratung</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500;600&family=Newsreader:ital,wght@0,350;1,350&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --paper: #eef2f1;
        --ink: #1a2b35;
        --deep: #26465a;
        --sand: #c9b87a;
        --sand-deep: #9f8a4e;
        --white-warm: #fbfaf6;
        --rule: rgba(38, 70, 90, 0.14);
        --soft: rgba(38, 70, 90, 0.55);
      }

      html, body {
        margin: 0; padding: 0;
        scroll-behavior: smooth;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Geist', system-ui, sans-serif;
      }

      .mono { font-family: 'Geist Mono', ui-monospace, monospace; }
      .serif { font-family: 'Newsreader', 'Times New Roman', serif; font-weight: 350; }

      /* Language switch */
      .lang-switch {
        display: inline-flex;
        align-self: center;
        justify-self: end;
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 999px;
        overflow: hidden;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
      }
      .lang-switch a {
        display: block;
        padding: 6px 12px;
        text-decoration: none;
        color: var(--soft);
        text-transform: uppercase;
      }
      .lang-switch a.active {
        background: var(--sand);
        color: var(--ink);
      }

      /* Page wrapper */
      .page {
        max-width: 1280px;
        margin: 0 auto;
      }

      /* Top bar */
      .top-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        padding: 24px 48px 0;
        align-items: center;
      }
      .top-bar-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Geist Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.02em;
        color: var(--deep);
        font-weight: 600;
      }
      .top-bar-brand span { color: var(--soft); font-weight: 400; }
      .top-bar-nav {
        display: flex;
        gap: 24px;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--soft);
        justify-content: center;
      }
      .top-bar-nav a { color: var(--soft); text-decoration: none; }

      /* Hero */
      .hero {
        padding: 64px 48px 48px;
        position: relative;
      }
      .hero-eyebrow {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--soft);
        margin-bottom: 20px;
      }
      .hero-h1 {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: clamp(36px, 4.4vw, 58px);
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
        color: var(--deep);
        white-space: nowrap;
      }
      .hero-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        margin-top: 36px;
        align-items: end;
      }
      .hero-sub {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-style: italic;
        font-size: 22px;
        line-height: 1.45;
        color: var(--ink);
        margin: 0;
        max-width: 34ch;
        opacity: 0.85;
        text-wrap: pretty;
      }
      .hero-cta-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        padding-left: 16px;
      }
      .hero-meta {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* CTA */
      .cta {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        padding: 15px 22px;
        font-family: 'Geist Mono', monospace;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 3px;
        text-decoration: none;
        transition: background-color 0.4s ease, color 0.4s ease, box-shadow 0.4s ease, transform 0.25s ease;
      }
      .cta .arrow {
        display: inline-block;
        transition: transform 0.3s ease;
      }
      .cta:hover .arrow { transform: translateX(8.5px); }
      .cta--sand {
        background: var(--sand);
        color: var(--deep);
        box-shadow: 0 1px 0 rgba(15, 31, 44, 0.08), inset 0 1px 0 rgba(255,255,255,0.25);
      }
      .cta--sand:hover {
        background: var(--deep);
        color: var(--white-warm);
        box-shadow: 0 4px 18px rgba(38, 70, 90, 0.22);
        transform: translateY(-1px);
      }

      /* Wave separator — fade at edges, halved opacity */
      .wave-sep {
        overflow: hidden;
        margin-top: 24px;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 16%, black 84%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0%, black 16%, black 84%, transparent 100%);
      }
      .wave-sep svg path { opacity: 0.5; }
      .wave-drift { color: var(--deep); }
      /* Master section grid: 200px label · 48px gap · 1fr content
         About, Services and Contact all share this so every heading
         and body line starts at the same x (296px from the page edge). */
      .sec {
        padding: 0 48px;
        display: grid;
        grid-template-columns: 200px 48px 1fr;
      }
      .sec > .sec-label { grid-column: 1 / 2; }
      .sec > .sec-content { grid-column: 3 / 4; min-width: 0; }

      /* About */
      .about {
        padding-top: 56px;
        padding-bottom: 56px;
      }
      .about .sec-content {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        column-gap: 48px;
        position: relative;
      }
      .section-label {
        font-family: 'Newsreader', serif;
        font-style: italic;
        font-weight: 350;
        font-size: 26px;
        line-height: 1;
        color: var(--sand-deep);
        letter-spacing: -0.01em;
        padding-top: 8px;
      }
      .section-label-mark {
        font-family: 'Geist Mono', monospace;
        font-style: normal;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--soft);
        margin-right: 10px;
        vertical-align: middle;
      }
      .about-name {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 42px;
        line-height: 1.05;
        color: var(--deep);
        margin-bottom: 8px;
        letter-spacing: -0.015em;
      }
      .about-role {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        color: var(--sand-deep);
        letter-spacing: 0.04em;
        margin-bottom: 24px;
      }
      .about-body {
        font-size: 17px;
        line-height: 1.6;
        margin: 0;
        max-width: 44ch;
        text-wrap: pretty;
      }
      .about-points {
        list-style: none;
        margin: 0;
        padding: 0;
        padding-top: 60px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .about-point { /* layout provided by .hangs */ }
      /* Hanging marker: pulls the number glyph left into the 48px master gap */
      .hangs {
        margin-left: -44px;
        display: grid;
        grid-template-columns: 32px 12px 1fr;
        align-items: baseline;
      }
      .hangs > .mark { grid-column: 1 / 2; text-align: right; }
      .hangs > .txt  { grid-column: 3 / 4; }
      .about-point-num {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--sand-deep);
        letter-spacing: 0.05em;
      }
      .about-point-text {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 19px;
        line-height: 1.35;
        color: var(--ink);
        font-style: italic;
      }

      /* Services — label in .sec-label, h2 + rows in .sec-content */
      .services {
        padding-top: 56px;
        padding-bottom: 64px;
      }
      .services .sec-content {
        display: flex;
        flex-direction: column;
      }
      .services-h2 {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 48px;
        margin: 0 0 28px;
        line-height: 1;
        color: var(--deep);
        letter-spacing: -0.02em;
      }
      .service-row {
        padding: 24px 0;
        border-top: 1px solid var(--rule);
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        column-gap: 48px;
        align-items: start;
        transition: padding-left 0.25s ease;
      }
      .service-row:last-child { border-bottom: 1px solid var(--rule); }
      .service-row:hover { padding-left: 8px; }
      /* "~" marker hangs in the 48px master gap, same rail as about-point numbers */
      .service-name {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 28px;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--deep);
        position: relative;
      }
      .service-name::before {
        content: "~";
        position: absolute;
        right: calc(100% + 12px);
        top: 6px;
        width: 32px;
        text-align: right;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.04em;
      }
      .service-body {
        font-size: 15px;
        line-height: 1.6;
        color: var(--ink);
        max-width: 42ch;
      }

      /* Contact band — horizontal padding from .sec, vertical own */
      .contact {
        padding-top: 64px;
        padding-bottom: 48px;
        background: var(--deep);
        color: var(--paper);
        position: relative;
        overflow: hidden;
      }
      .contact .sec-content { position: relative; }
      .contact-waves {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        opacity: 0.18;
        pointer-events: none;
        mask-image: linear-gradient(to right, black 40%, transparent 68%);
        -webkit-mask-image: linear-gradient(to right, black 40%, transparent 68%);
      }
      .contact-label {
        font-family: 'Newsreader', serif;
        font-style: italic;
        font-weight: 350;
        font-size: 26px;
        line-height: 1;
        color: var(--sand);
        letter-spacing: -0.01em;
        margin-bottom: 18px;
        position: relative;
      }
      .contact-label-mark {
        font-family: 'Geist Mono', monospace;
        font-style: normal;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(238, 242, 241, 0.55);
        margin-right: 10px;
        vertical-align: middle;
      }
      .contact-row {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 60px;
        align-items: end;
        position: relative;
      }
      .contact-h2 {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 68px;
        margin: 0;
        line-height: 1;
        letter-spacing: -0.025em;
      }
      .contact-sub {
        font-size: 16px;
        line-height: 1.55;
        margin: 0;
        max-width: 38ch;
        color: rgba(238, 242, 241, 0.78);
        text-wrap: pretty;
      }
      .contact-bottom {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(238, 242, 241, 0.18);
        padding-top: 24px;
        position: relative;
        flex-wrap: wrap;
        gap: 16px;
      }
      .contact-card {
        font-size: 13px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--sand);
        text-decoration: none;
        transition: opacity 0.2s ease;
      }
      .contact-card .arrow { display: inline-block; transition: transform 0.3s ease; }
      .contact-card:hover { opacity: 0.75; }
      .contact-card:hover .arrow { transform: translateX(4px); }

      /* Footer */
      .site-footer {
        padding: 20px 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .footer-copy {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.06em;
      }
      .footer-links {
        display: flex;
        gap: 24px;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.06em;
      }
      .footer-links a { color: var(--soft); text-decoration: none; }
      .footer-links a:hover { color: var(--ink); }

      /* Wave animations */
      @media (prefers-reduced-motion: no-preference) {
        .wave-drift--fast {
          animation: hafen-drift 6.5s ease-in-out infinite alternate;
        }
        .wave-drift--slow {
          animation: hafen-drift-slow 11s ease-in-out infinite alternate;
        }
        @keyframes hafen-drift {
          from { transform: translateX(0) translateY(0); }
          to   { transform: translateX(-72px) translateY(4px); }
        }
        @keyframes hafen-drift-slow {
          from { transform: translateX(0) translateY(0); }
          to   { transform: translateX(48px) translateY(-3px); }
        }
      }

      /* Mobile */
      @media (max-width: 900px) {
        .top-bar {
          grid-template-columns: 1fr auto;
          padding: 16px 24px 0;
        }
        .top-bar-nav { display: none; }

        .hero { padding: 40px 24px 32px; }
        .hero-h1 { font-size: clamp(28px, 7vw, 42px); white-space: normal; }
        .hero-cta-col { padding-left: 0; }
        .hero-row {
          grid-template-columns: 1fr;
          gap: 28px;
          margin-top: 24px;
        }

        .wave-sep { margin-top: 8px; }
        .wave-sep svg { width: calc(100% + 48px); }

        /* Collapse master grid to single column */
        .sec {
          grid-template-columns: 1fr;
          padding: 0 24px;
          gap: 20px;
        }
        .sec > .sec-label { grid-column: 1; }
        .sec > .sec-content { grid-column: 1; }

        .about { padding-top: 40px; padding-bottom: 40px; }
        .about .sec-content { grid-template-columns: 1fr; gap: 24px; }
        .about-points { padding-top: 0; }
        .hangs { margin-left: 0; }

        .services { padding-top: 40px; padding-bottom: 48px; }
        .service-row { grid-template-columns: 1fr; gap: 8px; }
        .service-name::before { display: none; }

        .contact { padding-top: 48px; padding-bottom: 36px; }
        .contact-row {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        .contact-h2 { font-size: clamp(36px, 8vw, 68px); }

        .site-footer { padding: 16px 24px; flex-direction: column; gap: 12px; align-items: flex-start; }
      }

      /* Business card page */
      .card-page {
        position: fixed;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        background: var(--ink);
        padding: 24px;
      }
      .biz-card {
        width: 100%;
        max-width: 440px;
        aspect-ratio: 85 / 54;
        background: var(--white-warm);
        border-radius: 4px;
        box-shadow: 0 12px 48px rgba(0,0,0,0.45), 0 2px 6px rgba(0,0,0,0.2);
        padding: 28px 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
      }
      .biz-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }
      .biz-card-logo {
        flex-shrink: 0;
      }
      .biz-card-name {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 40px;
        line-height: 1;
        letter-spacing: -0.02em;
        color: var(--deep);
        margin: 0;
      }
      .biz-card-rule {
        height: 1.5px;
        background: var(--sand);
        border: none;
        margin: 12px 0 10px;
        width: 100%;
      }
      .biz-card-role {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--soft);
        margin: 0;
      }
      .biz-card-footer {
        display: flex;
        flex-direction: column;
      }
      .biz-card-waves {
        overflow: hidden;
        margin: 0 -32px;
        line-height: 0;
        margin-bottom: 18px;
      }
      .biz-card-mid a {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--deep);
        text-decoration: none;
      }
      .biz-card-mid a:hover { text-decoration: underline; }
      .biz-card-bottom {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
      }
      .biz-card-phone {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--soft);
        text-decoration: none;
      }
      .biz-card-phone:hover { color: var(--deep); }
      .biz-card-url {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.04em;
        color: var(--soft);
      }
      .card-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 440px;
      }
      .card-back-link {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(238, 242, 241, 0.3);
        text-decoration: none;
      }
      .card-back-link:hover { color: rgba(238, 242, 241, 0.6); }
      .card-btn {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(238, 242, 241, 0.4);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: color 0.2s ease;
      }
      .card-btn:hover { color: rgba(238, 242, 241, 0.75); }

      @media print {
        .card-page {
          position: static;
          background: white;
          padding: 0;
          display: block;
        }
        .biz-card {
          width: 85mm;
          height: 54mm;
          max-width: none;
          aspect-ratio: auto;
          box-shadow: none;
          border: 0.5pt solid #ccc;
          border-radius: 0;
          padding: 7mm 9mm;
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
        }
        .card-back-link { display: none; }
      }
    </style>
  </head>
  <body>
    <%= @inner_content %>
    <script>
      (function () {
        var wave = [
          "    _     _     _     _     _     _  ",
          "___/ \\___/ \\___/ \\___/ \\___/ \\___/ \\_",
          "  _     _     _     _     _     _    ",
          "_/ \\___/ \\___/ \\___/ \\___/ \\___/ \\__",
          "      _     _     _     _     _      ",
          "_____/ \\___/ \\___/ \\___/ \\___/ \\____"
        ].join("\n");
        console.log("%c" + wave, "color:#26465a;font-family:monospace;line-height:1.6");
        console.log("%cIn case you’re wondering, it’s Elixir.", "color:#26465a;font-family:monospace;font-size:12px;");
        console.log(
          "%cGood to see you here.\nIf you’re curious about the stack or want to work together, drop me a line:\n%creibisch@proton.me",
          "color:#9f8a4e;font-family:monospace;font-size:13px;line-height:1.7",
          "color:#c9b87a;font-family:monospace;font-size:13px;line-height:1.7"
        );
      })();
    </script>
  </body>
</html>
