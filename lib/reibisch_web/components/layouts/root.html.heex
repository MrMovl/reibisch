<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Reibisch — Tomke Reibisch · Software &amp; Beratung</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500;600&family=Newsreader:ital,wght@0,350;1,350&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      :root {
        --paper: #eef2f1;
        --ink: #1a2b35;
        --deep: #26465a;
        --sand: #c9b87a;
        --sand-deep: #9f8a4e;
        --white-warm: #fbfaf6;
        --rule: rgba(38, 70, 90, 0.14);
        --soft: rgba(38, 70, 90, 0.55);
      }

      html, body {
        margin: 0; padding: 0;
        scroll-behavior: smooth;
        background: var(--paper);
        color: var(--ink);
        font-family: 'Geist', system-ui, sans-serif;
      }

      .mono { font-family: 'Geist Mono', ui-monospace, monospace; }
      .serif { font-family: 'Newsreader', 'Times New Roman', serif; font-weight: 350; }

      /* Language switch */
      .lang-switch {
        display: inline-flex;
        align-self: center;
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 999px;
        overflow: hidden;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
      }
      .lang-switch a {
        display: block;
        padding: 6px 12px;
        text-decoration: none;
        color: var(--soft);
        text-transform: uppercase;
      }
      .lang-switch a.active {
        background: var(--sand);
        color: var(--ink);
      }

      /* Page wrapper */
      .page {
        max-width: 1280px;
        margin: 0 auto;
      }

      /* Top bar */
      .top-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto;
        padding: 24px 48px 0;
        align-items: center;
      }
      .top-bar-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Geist Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.02em;
        color: var(--deep);
        font-weight: 600;
      }
      .top-bar-brand span { color: var(--soft); font-weight: 400; }
      .top-bar-nav {
        display: flex;
        gap: 24px;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--soft);
        justify-content: center;
      }
      .top-bar-nav a { color: var(--soft); text-decoration: none; }
      .top-bar-coords {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.06em;
        text-align: right;
        padding-right: 88px;
      }

      /* Hero */
      .hero {
        padding: 64px 48px 48px;
        position: relative;
      }
      .hero-eyebrow {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--soft);
        margin-bottom: 20px;
      }
      .hero-h1 {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 104px;
        line-height: 0.96;
        letter-spacing: -0.028em;
        margin: 0;
        color: var(--deep);
        max-width: 14ch;
      }
      .hero-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        margin-top: 36px;
        align-items: end;
      }
      .hero-sub {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-style: italic;
        font-size: 22px;
        line-height: 1.45;
        color: var(--ink);
        margin: 0;
        max-width: 34ch;
        opacity: 0.85;
        text-wrap: pretty;
      }
      .hero-cta-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
      }
      .hero-meta {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* CTA */
      .cta {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        padding: 15px 22px;
        font-family: 'Geist Mono', monospace;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border-radius: 3px;
        text-decoration: none;
        transition: background-color 0.4s ease, color 0.4s ease, box-shadow 0.4s ease, transform 0.25s ease;
      }
      .cta .arrow {
        display: inline-block;
        transition: transform 0.3s ease;
      }
      .cta:hover .arrow { transform: translateX(8.5px); }
      .cta--sand {
        background: var(--sand);
        color: var(--deep);
        box-shadow: 0 1px 0 rgba(15, 31, 44, 0.08), inset 0 1px 0 rgba(255,255,255,0.25);
      }
      .cta--sand:hover {
        background: var(--deep);
        color: var(--white-warm);
        box-shadow: 0 4px 18px rgba(38, 70, 90, 0.22);
        transform: translateY(-1px);
      }

      /* Wave separator */
      .wave-sep {
        overflow: hidden;
        margin-top: 8px;
      }
      .wave-drift {
        color: var(--deep);
      }

      /* About */
      .about {
        padding: 56px 48px 56px;
        display: grid;
        grid-template-columns: 200px 1fr 1fr;
        gap: 48px;
      }
      .section-label {
        font-family: 'Newsreader', serif;
        font-style: italic;
        font-weight: 350;
        font-size: 26px;
        line-height: 1;
        color: var(--sand-deep);
        letter-spacing: -0.01em;
        padding-top: 8px;
      }
      .section-label-mark {
        font-family: 'Geist Mono', monospace;
        font-style: normal;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--soft);
        margin-right: 10px;
        vertical-align: middle;
      }
      .about-name {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 42px;
        line-height: 1.05;
        color: var(--deep);
        margin-bottom: 8px;
        letter-spacing: -0.015em;
      }
      .about-role {
        font-family: 'Geist Mono', monospace;
        font-size: 13px;
        color: var(--sand-deep);
        letter-spacing: 0.04em;
        margin-bottom: 24px;
      }
      .about-body {
        font-size: 17px;
        line-height: 1.6;
        margin: 0;
        max-width: 44ch;
        text-wrap: pretty;
      }
      .about-points {
        list-style: none;
        margin: 0;
        padding: 0;
        padding-top: 60px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .about-point {
        display: grid;
        grid-template-columns: 32px 1fr;
        gap: 12px;
        align-items: baseline;
      }
      .about-point-num {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--sand-deep);
        letter-spacing: 0.05em;
      }
      .about-point-text {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 19px;
        line-height: 1.35;
        color: var(--ink);
        font-style: italic;
      }

      /* Services */
      .services {
        padding: 56px 48px 64px;
        border-top: 1px solid var(--rule);
      }
      .services-header {
        display: grid;
        grid-template-columns: 200px 1fr auto;
        gap: 48px;
        align-items: baseline;
        margin-bottom: 24px;
      }
      .services-h2 {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 48px;
        margin: 0;
        line-height: 1;
        color: var(--deep);
        letter-spacing: -0.02em;
      }
      .services-count {
        font-family: 'Geist Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--soft);
      }
      .service-row {
        padding: 24px 0;
        border-top: 1px solid var(--rule);
        display: grid;
        grid-template-columns: 60px 1fr 1.6fr 36px;
        gap: 28px;
        align-items: start;
        transition: padding-left 0.25s ease;
      }
      .service-row:last-child { border-bottom: 1px solid var(--rule); }
      .service-row:hover { padding-left: 8px; }
      .service-num {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        padding-top: 8px;
        letter-spacing: 0.04em;
      }
      .service-name {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 28px;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--deep);
      }
      .service-body {
        font-size: 15px;
        line-height: 1.6;
        color: var(--ink);
        max-width: 42ch;
      }
      .service-arrow {
        font-family: 'Geist Mono', monospace;
        font-size: 14px;
        color: var(--sand-deep);
        padding-top: 8px;
        text-align: right;
        transition: transform 0.25s ease, color 0.25s ease;
      }
      .service-row:hover .service-arrow {
        transform: translateX(4px);
        color: var(--deep);
      }

      /* Contact band */
      .contact {
        padding: 64px 48px 48px;
        background: var(--deep);
        color: var(--paper);
        position: relative;
        overflow: hidden;
      }
      .contact-waves {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        opacity: 0.18;
        pointer-events: none;
      }
      .contact-label {
        font-family: 'Newsreader', serif;
        font-style: italic;
        font-weight: 350;
        font-size: 26px;
        line-height: 1;
        color: var(--sand);
        letter-spacing: -0.01em;
        margin-bottom: 18px;
        position: relative;
      }
      .contact-label-mark {
        font-family: 'Geist Mono', monospace;
        font-style: normal;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(238, 242, 241, 0.55);
        margin-right: 10px;
        vertical-align: middle;
      }
      .contact-row {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 60px;
        align-items: end;
        position: relative;
      }
      .contact-h2 {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 68px;
        margin: 0;
        line-height: 1;
        letter-spacing: -0.025em;
      }
      .contact-sub {
        font-size: 16px;
        line-height: 1.55;
        margin: 0;
        max-width: 38ch;
        color: rgba(238, 242, 241, 0.78);
        text-wrap: pretty;
      }
      .contact-bottom {
        margin-top: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid rgba(238, 242, 241, 0.18);
        padding-top: 24px;
        position: relative;
        flex-wrap: wrap;
        gap: 16px;
      }
      .contact-email {
        font-family: 'Newsreader', serif;
        font-weight: 350;
        font-size: 38px;
        color: var(--sand);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .contact-email:hover { text-decoration: underline; }

      /* Footer */
      .site-footer {
        padding: 20px 48px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .footer-copy {
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.06em;
      }
      .footer-links {
        display: flex;
        gap: 24px;
        font-family: 'Geist Mono', monospace;
        font-size: 11px;
        color: var(--soft);
        letter-spacing: 0.06em;
      }
      .footer-links a { color: var(--soft); text-decoration: none; }
      .footer-links a:hover { color: var(--ink); }

      /* Wave animations */
      @media (prefers-reduced-motion: no-preference) {
        .wave-drift--fast {
          animation: hafen-drift 7s ease-in-out infinite alternate;
        }
        .wave-drift--slow {
          animation: hafen-drift-slow 11.5s ease-in-out infinite alternate;
        }
        @keyframes hafen-drift {
          from { transform: translateX(0); }
          to   { transform: translateX(-14px); }
        }
        @keyframes hafen-drift-slow {
          from { transform: translateX(0); }
          to   { transform: translateX(8px); }
        }
      }

      /* Mobile */
      @media (max-width: 900px) {
        .top-bar {
          grid-template-columns: 1fr auto;
          padding: 16px 24px 0;
        }
        .top-bar-nav { display: none; }
        .top-bar-coords { display: none; }

        .hero { padding: 40px 24px 32px; }
        .hero-h1 { font-size: clamp(52px, 10vw, 104px); }
        .hero-row {
          grid-template-columns: 1fr;
          gap: 28px;
          margin-top: 24px;
        }

        .wave-sep svg { width: 100%; }

        .about {
          grid-template-columns: 1fr;
          padding: 40px 24px;
          gap: 32px;
        }
        .about-points { padding-top: 0; }

        .services { padding: 40px 24px 48px; }
        .services-header {
          grid-template-columns: 1fr;
          gap: 12px;
          margin-bottom: 16px;
        }
        .service-row {
          grid-template-columns: 40px 1fr 36px;
          gap: 16px;
        }
        .service-body { display: none; }

        .contact { padding: 48px 24px 36px; }
        .contact-row {
          grid-template-columns: 1fr;
          gap: 20px;
        }
        .contact-h2 { font-size: clamp(36px, 8vw, 68px); }
        .contact-email { font-size: clamp(22px, 5vw, 38px); }

        .site-footer { padding: 16px 24px; flex-direction: column; gap: 12px; align-items: flex-start; }


      }
    </style>
  </head>
  <body>
    <%= @inner_content %>
  </body>
</html>
