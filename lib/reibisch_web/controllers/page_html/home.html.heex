<%
  lang = assigns[:lang] || "de"

  copy = %{
    "de" => %{
      nav: %{work: "Leistungen", about: "Über mich", contact: "Kontakt", projects: "Projekte"},
      hero: %{
        eyebrow: "Software · Apps · Beratung",
        question: "Tomke Reibisch · Software & Beratung",
        sub: "Ob klares Problem oder vage Ahnung: Sagen Sie mir, wo es hakt. Sie kennen Ihr Problem, ich kümmere mich um die Technik. Ich stelle die richtigen Fragen, und dann lösen wir es.",
        cta: "Schreiben Sie mir"
      },
      about: %{
        section: "Über",
        title: "Tomke Reibisch",
        role: "Entwickler & Berater · Norddeutschland · Remote",
        body: "Ich baue Dinge fürs Web, seit Websites noch „Homepages\" hießen. Heute heißt es Apps, APIs, Plattformen, Services. Die Grundfrage bleibt: Was soll das Ding eigentlich tun? Ich höre zu, stelle die richtigen Fragen, und liefere etwas, das funktioniert. Gut aufgestellt für Projekte, die zu komplex für eine Eigenlösung sind und zu spezifisch für eine Agentur. Pragmatisch, ohne Tüdelüt.",
        points: [
          "Sie bekommen keine Lösung, bevor ich Ihr Problem nicht in Gänze verstanden habe.",
          "Was ich baue, soll lange halten, nicht nur beim Launch gut aussehen.",
          "Meine besten Projekte entstehen, wenn ich mit jemandem rede, der das große Ganze noch selbst im Kopf hat."
        ]
      },
      services: %{
        section: "Leistungen",
        title: "Was ich mache",
        count: "3 Bereiche",
        items: [
          %{tag: "01", name: "Web & Apps", body: "Websites, Web-Apps und Mobile-Apps von der Idee bis zum Release. Klein anfangen, sauber wachsen, mit echten Nutzer:innen testen."},
          %{tag: "02", name: "Server & Systeme", body: "Backends, Integrationen, Datenpipelines. Lange Lebensdauer, wenig Drama. Inklusive Bestandssystemen, die gewachsen sind und jetzt jemanden brauchen, der sich wirklich reindenkt."},
          %{tag: "03", name: "Beratung", body: "Bestandsprojekt, das hängt. Neue Idee, die noch keine Form hat. Oder einfach eine zweite Meinung. Ich schaue mir an, was Sie haben, und sage Ihnen, was ich sehe. Sie entscheiden, was als nächstes passiert."}
        ]
      },
      projects: %{
        section: "Projekte",
        title: "Projekte",
        all_link: "Alle Projekte ansehen",
        items: [
          %{name: "Bildungsplattform", desc: "Lernplattform für Schulen"},
          %{name: "Tourismus-Apps", desc: "Mobile Apps für Tourismusbetriebe"},
          %{name: "Dashboards & Visualisierung", desc: "Datenanalyse im SAP-Ökosystem"}
        ]
      },
      contact: %{
        section: "Kontakt",
        title: "Reden wir",
        sub: "Eine kurze Nachricht reicht. Eine Skizze, ein Screenshot, ein halbfertiger Gedanke, egal was Sie haben. Ich melde mich innerhalb von zwei Werktagen.",
        email: "reibisch@proton.me",
        cta: "Schreiben Sie mir",
        card: "Visitenkarte",
        github: "GitHub"
      },
      footer: %{
        impressum: "Impressum",
        privacy: "Datenschutz"
      }
    },
    "en" => %{
      nav: %{work: "Services", about: "About", contact: "Contact", projects: "Projects"},
      hero: %{
        eyebrow: "Software · Apps · Consulting",
        question: "Tomke Reibisch · Software & Consulting",
        sub: "Tell me where it's stuck, whether it's a clear problem or just a vague hunch. You know your problem, I handle the tech. I ask the right questions, and then we solve it.",
        cta: "Send me a note"
      },
      about: %{
        section: "About",
        title: "Tomke Reibisch",
        role: "Developer & consultant · Northern Germany · Remote",
        body: "I’ve been building things for the web since websites were still called \"homepages\". Now it’s apps, APIs, platforms, services. The underlying question hasn’t changed: what is this thing actually supposed to do? I listen, ask the right questions, and deliver something that works. Well-placed for projects too complex for an in-house solution and too specific for an agency. Pragmatic, no theatre.",
        points: [
          "You won’t get a solution until I’ve fully understood your problem.",
          "What I build should last, not just look good at launch.",
          "My best projects happen when I’m talking to someone who still has the full picture in their head."
        ]
      },
      services: %{
        section: "Services",
        title: "What I do",
        count: "3 areas",
        items: [
          %{tag: "01", name: "Web & Apps", body: "Websites, web apps and mobile apps from sketch to release. Start small, grow cleanly, validate with people who'll actually use it."},
          %{tag: "02", name: "Server & Systems", body: "Backends, integrations, data pipelines. Built to last, low on drama. Including existing systems that have grown over time and now need someone who will actually think it through."},
          %{tag: "03", name: "Consulting", body: "An existing project that's stuck. A new idea that needs structure. Or just a second opinion. I look at what you have and tell you what I see. You decide what happens next."}
        ]
      },
      projects: %{
        section: "Projects",
        title: "Projects",
        all_link: "View all projects",
        items: [
          %{name: "Education platform", desc: "Learning platform for schools"},
          %{name: "Tourism apps", desc: "Mobile apps for tourism businesses"},
          %{name: "Dashboards & visualization", desc: "Data analysis in the SAP ecosystem"}
        ]
      },
      contact: %{
        section: "Contact",
        title: "Let's talk",
        sub: "A short message is enough. A sketch, a screenshot, a half-formed thought, whatever you've got. I'll get back to you within two business days.",
        email: "reibisch@proton.me",
        cta: "Send a message",
        card: "Business card",
        github: "GitHub"
      },
      footer: %{
        impressum: "Imprint",
        privacy: "Privacy"
      }
    }
  }

  t = copy[lang]
  year = DateTime.utc_now().year

  # Precompute SVG wave paths so we can use them in HEEx attribute values.
  # wave_path(y_offset, amplitude, period, width, step) -> SVG path "d" string
  wave_path = fn y_off, amp, period, width ->
    points =
      for x <- 0..width//4 do
        y = y_off + :math.sin(x / period * :math.pi() * 2) * amp
        "L #{x} #{Float.round(y, 2)}"
      end
    "M 0 #{y_off} " <> Enum.join(points, " ")
  end

  # Wave separator 1 (post-hero): 3 lines, amp=4, period=56, width=1400
  ws1_p1 = wave_path.(10, 4, 56, 1400)
  ws1_p2 = wave_path.(19, 4, 56, 1400)
  ws1_p3 = wave_path.(28, 4, 56, 1400)

  # Wave separator 2 (pre-contact): 2 lines, amp=3, period=56, width=1400
  ws2_p1 = wave_path.(9,  3, 56, 1400)
  ws2_p2 = wave_path.(19, 3, 56, 1400)

  # Contact band background waves: 4 lines, amp=6, period=80, width=1400
  cb_p1 = wave_path.(20,  6, 80, 1400)
  cb_p2 = wave_path.(48,  6, 80, 1400)
  cb_p3 = wave_path.(76,  6, 80, 1400)
  cb_p4 = wave_path.(104, 6, 80, 1400)

%>

<div class="page">

  <%# Top bar %>
  <div class="top-bar">
    <div class="top-bar-brand mono">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" style="display:inline-block;vertical-align:middle;flex-shrink:0">
        <rect width="32" height="32" fill="#26465a" rx="4"/>
        <text x="16" y="21" text-anchor="middle" font-family="Newsreader, serif" font-style="italic" font-weight="400" font-size="20" fill="#eef2f1">R</text>
        <path d="M 8 27 Q 12 24 16 27 T 24 27" fill="none" stroke="#c9b87a" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </div>
    <nav class="top-bar-nav">
      <a href="#services"><%= t.nav.work %></a>
      <a href="#projects"><%= t.nav.projects %></a>
      <a href="#about"><%= t.nav.about %></a>
      <a href="#contact"><%= t.nav.contact %></a>
    </nav>
    <button
      type="button"
      class="nav-burger"
      aria-label={if lang == "de", do: "Menü öffnen", else: "Open menu"}
      aria-expanded="false"
      aria-controls="mobile-nav"
    ><span></span><span></span><span></span></button>
    <nav class="lang-switch" aria-label="Language">
      <a href="/" class={if lang == "de", do: "active", else: ""}>DE</a>
      <a href="/en" class={if lang == "en", do: "active", else: ""}>EN</a>
    </nav>
  </div>

  <nav id="mobile-nav" class="mobile-nav-panel mono">
    <a href="#services"><%= t.nav.work %></a>
    <a href="#projects"><%= t.nav.projects %></a>
    <a href="#about"><%= t.nav.about %></a>
    <a href="#contact"><%= t.nav.contact %></a>
  </nav>

  <%# Hero %>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero-h1 serif"><%= t.hero.question %></h1>
    <div class="hero-row">
      <p class="hero-sub serif"><%= t.hero.sub %></p>
      <div class="hero-cta-col">
        <a href={"mailto:#{t.contact.email}"} class="cta cta--sand">
          <%= t.hero.cta %> <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <%# Wave separator 1: 3 lines after hero %>
  <div class="wave-sep" aria-hidden="true">
    <div class="wave-drift wave-drift--fast">
      <svg width="1400" height="38" viewBox="0 0 1400 38" aria-hidden="true">
        <path d={ws1_p1} stroke="#26465a" stroke-width="1" fill="none" opacity="0.87" stroke-linecap="round"/>
        <path d={ws1_p2} stroke="#26465a" stroke-width="1" fill="none" opacity="0.74" stroke-linecap="round"/>
        <path d={ws1_p3} stroke="#26465a" stroke-width="1" fill="none" opacity="0.61" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <%# Services %>
  <section id="services" class="sec services" aria-labelledby="services-heading">
    <div class="sec-label">
      <div class="section-label serif">
        <span class="section-label-mark mono">01</span><%= t.services.section %>
      </div>
    </div>
    <div class="sec-content">
      <h2 id="services-heading" class="services-h2 serif"><%= t.services.title %></h2>
      <%= for s <- t.services.items do %>
        <div class="service-row">
          <div class="service-name serif"><%= s.name %></div>
          <div class="service-body"><%= s.body %></div>
        </div>
      <% end %>
    </div>
  </section>

  <%# Projects (short list, links to dedicated page) %>
  <section id="projects" class="sec services" aria-labelledby="projects-heading">
    <div class="sec-label">
      <div class="section-label serif">
        <span class="section-label-mark mono">02</span><%= t.projects.section %>
      </div>
    </div>
    <div class="sec-content">
      <h2 id="projects-heading" class="services-h2 serif"><%= t.projects.title %></h2>
      <%= for p <- t.projects.items do %>
        <div class="service-row">
          <div class="service-name serif"><%= p.name %></div>
          <div class="service-body"><%= p.desc %></div>
        </div>
      <% end %>
      <a href={if lang == "de", do: "/projekte", else: "/projects"} class="projects-all-link mono">
        <%= t.projects.all_link %> <span class="arrow">→</span>
      </a>
    </div>
  </section>

  <%# About %>
  <section id="about" class="sec about" aria-labelledby="about-heading">
    <div class="sec-label">
      <div class="section-label serif">
        <span class="section-label-mark mono">03</span><%= t.about.section %>
      </div>
    </div>
    <div class="sec-content">
      <div class="about-block">
        <div id="about-heading" class="about-name serif"><%= t.about.title %></div>
        <div class="about-role mono"><%= t.about.role %></div>
        <p class="about-body"><%= t.about.body %></p>
      </div>
      <ul class="about-points" aria-label="Principles">
        <%= for point <- t.about.points do %>
          <li class="about-point hangs">
            <span class="mark about-point-num mono">~</span>
            <span class="txt about-point-text serif"><%= point %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <%# Wave separator 2: 2 lines before contact %>
  <div class="wave-sep" aria-hidden="true">
    <div class="wave-drift wave-drift--fast">
      <svg width="1400" height="28" viewBox="0 0 1400 28" aria-hidden="true">
        <path d={ws2_p1} stroke="#26465a" stroke-width="1" fill="none" opacity="0.87" stroke-linecap="round"/>
        <path d={ws2_p2} stroke="#26465a" stroke-width="1" fill="none" opacity="0.74" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <%# Contact band %>
  <section id="contact" class="sec contact" aria-labelledby="contact-heading">
    <%# Background waves (absolute, out of grid flow) %>
    <div class="contact-waves wave-drift wave-drift--slow" aria-hidden="true">
      <svg width="1400" height="130" viewBox="0 0 1400 130" aria-hidden="true">
        <path d={cb_p1} stroke="#c9b87a" stroke-width="1" fill="none" opacity="1.0"  stroke-linecap="round"/>
        <path d={cb_p2} stroke="#c9b87a" stroke-width="1" fill="none" opacity="0.85" stroke-linecap="round"/>
        <path d={cb_p3} stroke="#c9b87a" stroke-width="1" fill="none" opacity="0.70" stroke-linecap="round"/>
        <path d={cb_p4} stroke="#c9b87a" stroke-width="1" fill="none" opacity="0.55" stroke-linecap="round"/>
      </svg>
    </div>

    <div class="sec-label">
      <div class="contact-label serif">
        <span class="contact-label-mark mono">04</span><%= t.contact.section %>
      </div>
    </div>
    <div class="sec-content">
      <div class="contact-row">
        <h2 id="contact-heading" class="contact-h2 serif"><%= t.contact.title %></h2>
        <p class="contact-sub"><%= t.contact.sub %></p>
      </div>
      <div class="contact-bottom">
        <a href="/card" class="contact-card mono"><%= t.contact.card %> <span class="arrow">→</span></a>
        <a href="https://github.com/MrMovl" class="contact-card mono" target="_blank" rel="noopener noreferrer"><%= t.contact.github %> <span class="arrow">→</span></a>
        <a href={"mailto:#{t.contact.email}"} class="cta cta--sand">
          <%= t.contact.cta %> <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <%# Footer %>
  <footer class="site-footer">
    <div class="footer-copy mono">© <%= year %> · Tomke Reibisch</div>
    <div class="footer-links mono">
      <a href={if lang == "de", do: "/impressum", else: "/imprint"}><%= t.footer.impressum %></a>
      <a href={if lang == "de", do: "/datenschutz", else: "/privacy"}><%= t.footer.privacy %></a>
    </div>
  </footer>

</div>
